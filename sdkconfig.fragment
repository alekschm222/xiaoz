# SDKConfig Fragment для радио
# Скопируйте в sdkconfig.defaults или примените через idf.py menuconfig

# PSRAM (обязательно для буферов радио)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# CPU частота 240 МГц
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# FreeRTOS — больше задач
CONFIG_FREERTOS_HZ=1000

# I2S
CONFIG_SOC_I2S_NUM=2

# Partition table — если нужен большой assets
# CONFIG_PARTITION_TABLE_CUSTOM=y
# CONFIG_PARTITION_TABLE_FILENAME="partitions_radio.csv"

# HTTP client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# SPI — для LCD
CONFIG_SPI_MASTER_IN_IRAM=y
